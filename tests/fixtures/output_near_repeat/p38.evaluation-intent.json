{"key":"G:6:1","kind":"evaluation","request":{"confirm_records":false,"source":"import numpy as np\nimport time\n\nN = 26\nTMAX = 27.0\n_SHRINK = 5.0e-8\n\n_CENTERS = np.array([\n    [0.19987880459181062, 0.19987880459180976],\n    [0.3112087345912405, 0.10767283723316759],\n    [0.5241678939283936, 0.10529954608554805],\n    [0.732789767989086, 0.10333160957131823],\n    [0.9174764429525418, 0.08252355704745908],\n    [0.10767283723317228, 0.3112087345912389],\n    [0.26649037586211916, 0.2664903758621209],\n    [0.4219339494881126, 0.2820659057372074],\n    [0.6323020981210657, 0.2935278209351508],\n    [0.8720092403120582, 0.2880691992649992],\n    [0.1052995460855501, 0.5241678939283897],\n    [0.282065905737209, 0.4219339494881112],\n    [0.500875699551039, 0.5008756995510382],\n    [0.7411848930296812, 0.4835414617975845],\n    [0.9241996130337772, 0.4850641140465449],\n    [0.1033316095713174, 0.7327897679890851],\n    [0.29352782093515023, 0.6323020981210653],\n    [0.483541461797584, 0.7411848930296822],\n    [0.6554424848869991, 0.6554424848869982],\n    [0.8691963239827653, 0.6842119913509327],\n    [0.0825235570474582, 0.9174764429525429],\n    [0.2880691992649988, 0.8720092403120568],\n    [0.48506411404654426, 0.9241996130337768],\n    [0.6842119913509328, 0.8691963239827654],\n    [0.9059919955147084, 0.9059919955147074],\n    [0.10180899211692869, 0.10180899211692893],\n], dtype=np.float64)\n\n_BASE_RADII = np.array([\n    0.036882666707539466, 0.10767283712548739,\n    0.10529954598024174, 0.10333160946797867,\n    0.08252355696492672, 0.10767283712549221,\n    0.057320320699696066, 0.0989016421086508,\n    0.11177852632322166, 0.1279907595599425,\n    0.10529954598024098, 0.09890164210865023,\n    0.13371290099564803, 0.10722066692867226,\n    0.07580038689041331, 0.10333160946797751,\n    0.11177852632322069, 0.10722066692867155,\n    0.08487754290027, 0.13080367588642253,\n    0.08252355696492489, 0.12799075955994388,\n    0.07580038689041374, 0.13080367588642236,\n    0.09400800439127527, 0.10180899201510989,\n], dtype=np.float64)\n\n\ndef _lp_radii(centers):\n    centers = np.asarray(centers, dtype=np.float64)\n    n = centers.shape[0]\n    b = np.minimum.reduce((centers[:, 0], centers[:, 1],\n                           1.0 - centers[:, 0], 1.0 - centers[:, 1]))\n    try:\n        from scipy.optimize import linprog\n        rows = []\n        rhs = []\n        for i in range(n):\n            for j in range(i + 1, n):\n                a = np.zeros(n, dtype=np.float64)\n                a[i] = 1.0\n                a[j] = 1.0\n                rows.append(a)\n                rhs.append(float(np.linalg.norm(centers[i] - centers[j])))\n        res = linprog(-np.ones(n), A_ub=np.asarray(rows), b_ub=np.asarray(rhs),\n                      bounds=[(0.0, float(x)) for x in b], method=\"highs\")\n        if res.success and np.all(np.isfinite(res.x)):\n            return np.maximum(0.0, res.x - 1.0e-8)\n    except Exception:\n        pass\n    return np.maximum(0.0, np.minimum(b, _BASE_RADII[:n]) - _SHRINK)\n\n\ndef compute_max_radii(centers):\n    return _lp_radii(centers)\n\n\ndef _valid(c, r):\n    if c.shape != (N, 2) or r.shape != (N,):\n        return False\n    if not (np.all(np.isfinite(c)) and np.all(np.isfinite(r)) and np.all(r >= 0)):\n        return False\n    if np.min(c) < 0 or np.max(c) > 1:\n        return False\n    b = np.minimum.reduce((c[:, 0], c[:, 1], 1.0 - c[:, 0], 1.0 - c[:, 1]))\n    if np.any(r > b):\n        return False\n    for i in range(N):\n        d = c[i + 1:] - c[i]\n        if len(d) and np.any(r[i] + r[i + 1:] > np.sqrt(np.sum(d * d, axis=1))):\n            return False\n    return True\n\n\ndef construct_packing():\n    start = time.time()\n    centers = _CENTERS.copy()\n    radii = np.maximum(0.0, _BASE_RADII - _SHRINK)\n    if time.time() - start < TMAX - 1.0 and not _valid(centers, radii):\n        radii = _lp_radii(centers)\n        radii = np.maximum(0.0, radii - _SHRINK)\n    return centers.astype(float), radii.astype(float), float(np.sum(radii))\n\n\ndef run_packing():\n    return construct_packing()\n\n\ndef visualize(centers, radii):\n    import matplotlib.pyplot as plt\n    from matplotlib.patches import Circle\n    fig, ax = plt.subplots(figsize=(8, 8))\n    ax.set_xlim(0, 1)\n    ax.set_ylim(0, 1)\n    ax.set_aspect(\"equal\")\n    for center, radius in zip(centers, radii):\n        ax.add_patch(Circle(center, radius, alpha=0.5))\n    plt.title(f\"n={len(radii)} sum={float(np.sum(radii)):.9f}\")\n    plt.show()\n\n\nif __name__ == \"__main__\":\n    print(run_packing()[2])\n","task_hash":"86fe9a3ea046a1714b9e67f67b8ca916addaaadcf998e1a5260578f6c4e2489a"},"request_sha256":"4d21264da1f21424d497b94f22b12b25720a7d0bc13f59a9fa8de3416f4bceee","schema":"sciel-parallel-call/1"}