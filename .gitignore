# Deny by default. Keep source, maintained configuration, and test fixtures only.
*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/Makefile
!/pyproject.toml
!/MANIFEST.in

!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

!/src/
!/src/sciel/
!/src/sciel/**/
!/src/sciel/**/*.py
!/src/sciel/engine/prompt/templates/*.txt

!/scripts/
!/scripts/**/
!/scripts/**/*.py
!/scripts/**/*.sh

!/configs/
!/configs/**/
!/configs/**/*.yaml
!/configs/**/*.json

!/tasks/
!/tasks/**/
!/tasks/**/*.py
!/tasks/**/task.yaml
!/tasks/**/Dockerfile

!/docker/
!/docker/**/
!/docker/**/Dockerfile

!/tests/
!/tests/**/
!/tests/**/*.py
!/tests/fixtures/**/*.json
!/tests/fixtures/**/*.jsonl
!/tests/fixtures/**/*.txt

# Never include credentials, generated files, caches, or vendored dependencies.
**/.env
**/.env.*
**/*credentials*
**/*.pem
**/*.key
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.DS_Store
**/*.egg-info/
**/.venv/
**/node_modules/
